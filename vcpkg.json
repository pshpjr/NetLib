{
  "name": "net-lib",
  "version-string": "0.1",
  "dependencies": [
    "cpptrace",
    "curl",
    "libmysql",
    {
      "name": "range-v3",
      "version>=": "0.12.0#2"
    },
    {
      "name": "gtest",
      "version>=": "1.15.2"
    },
    {
      "name": "redis-plus-plus"
    },
    "libiconv",
    "tomlplusplus",
    {
      "name": "liburing",
      "platform": "linux"
    },
    "fmt"
  ],
  "features": {
    "tracy": {
      "description": "Enable optional Tracy profiling",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "on-demand"
          ]
        }
      ]
    },
    "otel": {
      "description": "Enable the OTLP/HTTP metric exporter",
      "dependencies": [
        {
          "name": "opentelemetry-cpp",
          "default-features": false,
          "features": [
            "otlp-http"
          ]
        }
      ]
    }
  }
}
